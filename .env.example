# =============================================================================
# ISLAMIC LAUNCHER (KHUSUS ANDROID) - ENVIRONMENT VARIABLES (.env)
# =============================================================================
# Salin file ini menjadi ".env" di root project, lalu isi dengan AdMob ID produksi Anda.
# File ".env" sudah otomatis dimasukkan ke .gitignore agar ID Anda tidak bocor ke Git.
#
# Nilai default di bawah adalah ID Resmi Test dari Google (Aman digunakan untuk testing).
# =============================================================================

# 1. AdMob App ID (Format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX - gunakan tanda gelombang '~')
# Disuntikkan otomatis ke AndroidManifest.xml via Gradle build.gradle.kts
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# 2. Rewarded Ad Unit ID (Format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX - gunakan garis miring '/')
# Ditampilkan sebagai 'Tiket Bebas Iklan 10 Menit' saat membuka aplikasi non-produktif >= 3x
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# 3. Banner Ad Unit ID (Format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX - gunakan garis miring '/')
# Ditampilkan di bagian bawah drawer daftar aplikasi
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-3940256099942544/6300978111

# 4. Native Ad Unit ID (Format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX - gunakan garis miring '/')
# Ditampilkan di menu apps bertingkat sesuai frekuensi membuka aplikasi non-produktif
ADMOB_NATIVE_AD_UNIT_ID=ca-app-pub-3940256099942544/2247696110
